  m_text: "\u0414\u0430\u043D\u043D\u043E\u0435 \u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435
    \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442 \u0435\u0434\u0443
    \u0432 \u043A\u043E\u043B\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0435 10
    \u0435\u0434\u0438\u043D\u0438\u0446 \u0437\u0430 \u0446\u0438\u043A\u043B. \u041D\u0443\u0436\u0434\u0430\u0435\u0442\u0441\u044F
    \u0432 \u0440\u0430\u0437\u043C\u0435\u0449\u0435\u043D\u0438\u0438 \u0440\u044F\u0434\u043E\u043C
