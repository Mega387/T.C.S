    \u041D\u0435 \u0442\u0440\u0430\u0442\u0438\u0442 \u043D\u0438\u043A\u0430\u043A\u0438\u0435
    \u0440\u0435\u0441\u0443\u0440\u0441\u044B , \u0442\u043E\u043B\u044C\u043A\u043E
    \u0432\u0440\u0435\u043C\u044F"
