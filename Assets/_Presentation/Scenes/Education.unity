      m_Calls: []
  m_text: "\u044D\u0442\u043E \u0432\u0430\u0448\u0438 \u0440\u0430\u0431\u043E\u0447\u0438\u0435
    , \u0440\u044F\u0434\u043E\u043C \u0441 \u043D\u0438\u043C\u0438 \u0434\u043E\u043B\u0436\u0434\u044B
    \u0440\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u0442\u044C\u0441\u044F
    \u0440\u0430\u0431\u043E\u0447\u0438\u0435 \u0441\u0442\u0440\u043E\u0435\u043D\u0438\u044F
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0447\u0442\u043E-\u0442\u043E \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u044F\u0442
    , \u0442\u0430\u043A\u0438\u0435 \u043A\u0430\u043A: \u0444\u0435\u0440\u043C\u044B
    , \u043B\u0435\u0441\u043E\u0440\u0443\u0431\u044B , \u0448\u0430\u0445\u0442\u044B
    \u0438 \u0442\u0434. \u0417\u0430 \u0438\u0441\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435\u043C
    \u0442\u0435\u0445 \u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0439 \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u043D\u0435 \u043D\u0443\u0436\u0434\u0430\u044E\u0442\u0441\u044F \u0432 \u0440\u0430\u0431\u043E\u0447\u0438\u0445
    \u0433\u0440\u0430\u0436\u0434\u0430\u043D                                         
    \u041F\u043E\u0442\u0440\u0435\u0431\u043B\u044F\u0435\u0442 5 \u0435\u0434\u0438\u043D\u0438\u0446
    \u0435\u0434\u044B \u0437\u0430 \u0446\u0438\u043A\u043B"
